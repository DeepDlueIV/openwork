# Access: enable Vercel Authentication for Preview in the project settings.
# Private Vercel Blob store token, used by both the app and publisher.
BLOB_READ_WRITE_TOKEN=
# Publisher: the review app's stable alias origin (not a per-deployment URL).
OPENWORK_REVIEW_URL=
# Optional local artifact directory, shared by the local app and publisher.
OPENWORK_REVIEW_LOCAL_DIR=
# Preferred provider: freestyle (default when unset) or daytona. Configured,
# enabled providers are selectable; a sole available provider is selected automatically.
# Saved checkpoints always open with the provider that saved them.
OPENWORK_EVIDENCE_PROVIDER=
# Server-only credentials. Never pass these to guests or the browser.
FREESTYLE_API_KEY=
DAYTONA_API_KEY=
# Optional Daytona REST origin/region (no local CLI authentication is consulted).
DAYTONA_API_URL=https://app.daytona.io/api
OPENWORK_DAYTONA_EVIDENCE_REGION=us-west-3
# Trusted HTTPS-only feature authority, not a feature enable switch. Daytona fresh previews
# require reviewerDaytonaPreviews from /v1/features, off by default, cloud only.
# The authority must support no-cache reads with private,no-store responses.
DEN_API_BASE=https://api.openworklabs.com
