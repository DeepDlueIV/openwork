{
  "name": "@openwork/documents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reusable connected-document browser: provider contracts, Google Drive adapter and React browser.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/browser.tsx",
      "default": "./src/browser.tsx"
    },
    "./styles.css": "./src/styles.css",
    "./model": {
      "types": "./src/model.ts",
      "default": "./src/model.ts"
    },
    "./office": {
      "types": "./src/office.ts",
      "default": "./src/office.ts"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.3.6",
    "lucide-react": "^0.577.0",
    "@openwork/workbook": "workspace:*"
  },
  "peerDependencies": {
    "react": "catalog:",
    "@tanstack/react-query": "^5.96.2"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "react": "catalog:",
    "@tanstack/react-query": "^5.96.2",
    "typescript": "^5.9.3"
  }
}
